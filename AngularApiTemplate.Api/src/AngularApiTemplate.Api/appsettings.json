{
  "KeyVault": {
    "Name": "angular-template-dev-kv"
  },
  "Foundation": {
    "ServiceName": "AngularApiTemplate.Api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ApplicationDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Entra": {
    "Enabled": false,
    "Instance": "https://YOUR-TENANT.ciamlogin.com/",
    "TenantId": "YOUR-TENANT-ID",
    "ClientId": "YOUR-API-CLIENT-ID",
    "Audience": "YOUR-API-CLIENT-ID"
  }
}
